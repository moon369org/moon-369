{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/night/:d",
      "destination": "/api/night?d=:d"
    },
    {
      "source": "/eclipse/:date",
      "destination": "/api/eclipse?date=:date"
    },
    {
      "source": "/m/:mark",
      "destination": "/api/m?mark=:mark"
    },
    {
      "source": "/by/:name",
      "destination": "/by"
    },
    {
      "source": "/tide/:lune",
      "destination": "/tide"
    }
  ],
  "headers": [
    {
      "source": "/pki/(.*).crl",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/pkix-crl"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/pki/(.*).cer",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/pkix-cert"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/pki/(.*).pem",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/x-pem-file"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/app-sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/app"
        }
      ]
    },
    {
      "source": "/app.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        }
      ]
    },
    {
      "source": "/assets/moon/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/check",
      "destination": "/verify",
      "permanent": true
    }
  ]
}
