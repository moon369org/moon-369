{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/night/:d",
      "destination": "/api/night?d=:d"
    },
    {
      "source": "/eclipse/:date",
      "destination": "/api/eclipse?date=:date"
    },
    {
      "source": "/m/:mark",
      "destination": "/api/m?mark=:mark"
    },
    {
      "source": "/by/:name",
      "destination": "/by.html"
    }
  ]
}
