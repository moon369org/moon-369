{
  "name": "moon369-capture",
  "version": "0.1.0",
  "description": "Sign photos and video at capture: C2PA Content Credentials timestamped by Moon, with a signed Moonmark inside. The answer to 'was this real, and when?'",
  "license": "MIT",
  "author": "Moon <moon369org@proton.me>",
  "homepage": "https://moon369.org/capture",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moon369org/moon-369.git",
    "directory": "packages/capture"
  },
  "keywords": [
    "c2pa",
    "content-credentials",
    "provenance",
    "deepfake",
    "timestamp",
    "rfc3161",
    "moonmark",
    "capture"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "prepublishOnly": "npm test && npm run build"
  },
  "dependencies": {
    "@contentauth/c2pa-node": "^0.12.0",
    "moon369": "^1.3.0"
  },
  "peerDependencies": {
    "sharp": ">=0.33"
  },
  "peerDependenciesMeta": {
    "sharp": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0",
    "sharp": "^0.35.0"
  }
}
