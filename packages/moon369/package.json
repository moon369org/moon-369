{
  "name": "moon369",
  "version": "1.6.0",
  "description": "Moon time, offline: the worldwide timestamp locked to the moon. Moonmarks, Moon dates, moon phase, Moon's live moon (<moon-live>) and signed Moonmark verification.",
  "license": "MIT",
  "author": "Moon <moon369org@proton.me>",
  "homepage": "https://moon369.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moon369org/moon-369.git",
    "directory": "packages/moon369"
  },
  "keywords": [
    "moon",
    "time",
    "timestamp",
    "calendar",
    "moonmark",
    "lunar",
    "ed25519",
    "provenance"
  ],
  "type": "module",
  "main": "./dist/index.js",
